    contentS: '#!/bin/bash\n' +
      '\n' +
      'script_dir=$(dirname "$0")\n' +
      'current_working_dir=$(pwd)\n' +
      'FILE_NAME="${current_working_dir}/.gitignore"\n' +
      '\n' +
      '#content=$(cat "node.gitignore")\n' +
      'echo "$script_dir"\n' +
      '\n' +
      'case "$1" in \n' +
      '    node | nodejs) \n' +
      '        #cat node.gitignore\n' +
      '        content=$(cat "${script_dir}/node.gitignore")\n' +
      '        echo "$content" > $FILE_NAME\n' +
      '        echo "$FILE_NAME is successfully created for Node.js project"\n' +
      '        ;;\n' +
      '    flask)\n' +
      '        content=$(cat "${script_dir}/flask.gitignore")\n' +
      '        echo "$content" > $FILE_NAME\n' +
      '        echo "$FILE_NAME is successfully created for Flask project"\n' +
      '        ;;\n' +
      '    django)\n' +
      '        content=$(cat "${script_dir}/django.gitignore")\n' +
      '        echo "$content" > $FILE_NAME\n' +
      '        echo "$FILE_NAME is successfully created for Django project"\n' +
      '        ;;\n' +
      '    java | springboot)\n' +
      '        content=$(cat "${script_dir}/java.gitignore")\n' +
      '        echo "$content" > $FILE_NAME\n' +
      '        echo "$FILE_NAME is successfully created for Java project"\n' +
      '        ;;\n' +
      '    *) \n' +
      '        echo "Usage: $0 {node|flask|django|java|springboot}" \n' +
      '        ;; \n' +
