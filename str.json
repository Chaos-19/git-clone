      '        # Get the directory of the script\n' +
      '        script_dir=$(dirname "$script_path")\n' +
      '\n' +
      '        # Append the directory to .bashrc if not already added\n' +
      '        if ! grep -q "$script_dir" ~/.bashrc; then\n' +
